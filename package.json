{
  "name": "lanka-studio",
  "version": "0.10.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:domain && npm run build",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "test:domain": "node scripts/test-domain.mjs",
    "test:focus-v3": "node scripts/check-focus-v3.mjs",
    "build:mcp": "node scripts/build-project-mcp.mjs",
    "setup:chat": "node scripts/setup-local-chat.mjs",
    "test:chat": "node --test scripts/project-mcp/chat.test.mjs runtime/app-server.test.mjs scripts/project-mcp/login-completion.test.mjs",
    "test:library-mcp": "npm run build:mcp && node --test scripts/project-mcp/library-mcp.test.mjs",
    "test:run-mcp": "npm run build:mcp && node --test scripts/project-mcp/run-mcp.test.mjs",
    "test:migration": "npm run build:mcp && node --test scripts/project-mcp/migration.test.mjs",
    "test:export-artifacts": "npm run build:mcp && node --test scripts/project-mcp/export-artifacts.test.mjs",
    "test:project": "npm run build:mcp && node --test scripts/project-mcp/project.test.mjs scripts/project-mcp/web.test.mjs scripts/project-mcp/focus-v3.test.mjs scripts/project-mcp/library.test.mjs scripts/project-mcp/local-client.test.mjs scripts/project-mcp/image-upload.test.mjs scripts/project-mcp/data-window.test.mjs scripts/project-mcp/review-navigation.test.mjs",
    "start:project": "node .project-runtime/web.mjs",
    "start:local": "bash scripts/start-local.sh",
    "demo:history": "node scripts/seed-history-demo.mjs",
    "start:local:background": "bash scripts/local-server.sh start",
    "stop:local": "bash scripts/local-server.sh stop",
    "restart:local": "bash scripts/local-server.sh restart",
    "test:browser-auth": "node --test scripts/project-mcp/browser-auth.test.mjs",
    "test:organizations": "node --test scripts/project-mcp/organization-access.test.mjs",
    "test:corporate-client": "node --test scripts/project-mcp/corporate-client.test.mjs",
    "start:self-hosted": "node .project-runtime/self-hosted-server.mjs",
    "db:self-hosted:migrate": "node .project-runtime/migrate-self-hosted.mjs",
    "test:resources": "node --test scripts/project-mcp/resource-access.test.mjs",
    "package:companion": "node scripts/package-companion.mjs",
    "check:source": "node scripts/check-source.mjs",
    "package:sbom": "node scripts/build-sbom.mjs",
    "check:editor-browser": "npm run build:mcp && node scripts/check-editor-browser.mjs",
    "check:data-inspector-browser": "npm run build:mcp && node scripts/check-data-inspector-browser.mjs",
    "check:chat-browser": "npm run build:mcp && node scripts/check-chat-browser.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.18",
    "@assistant-ui/react-markdown": "0.14.14",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@seekskyworld/creatppt": "0.1.4",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jose": "6.2.11",
    "jszip": "3.10.1",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "openid-client": "6.8.8",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "pptxgenjs": "4.0.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.34.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "6.2.5",
    "pixelmatch": "7.1.0",
    "playwright": "1.58.2",
    "pngjs": "7.0.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "license": "Apache-2.0"
}
