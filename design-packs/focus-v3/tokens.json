{
  "id": "focus-v3",
  "version": 3,
  "name": "Focus 3 — редакционный",
  "canvas": { "width": 1600, "height": 900 },
  "grid": { "margin": 96, "columns": 12, "column": 88, "gutter": 32, "frame": 1408, "unit": 8 },
  "zones": {
    "chromeTop": 56,
    "chromeHeight": 16,
    "titleTop": 168,
    "contentBottom": 796,
    "footerTop": 836,
    "minTitleGap": 64,
    "titleToLead": 56
  },
  "typography": {
    "family": { "sans": "IBM Plex Sans", "mono": "IBM Plex Mono" },
    "weights": { "regular": 400, "bold": 600, "mono": 500 },
    "metrics": "lib/domain/font-metrics-plex.json",
    "roles": {
      "display":   { "size": 108, "font": "sans", "bold": true,  "lineHeight": 0.98, "tracking": -0.03 },
      "displayS":  { "size": 104, "font": "sans", "bold": true,  "lineHeight": 0.98, "tracking": -0.03 },
      "h1":        { "size": 80,  "font": "sans", "bold": true,  "lineHeight": 1.04, "tracking": -0.025 },
      "h2":        { "size": 32,  "font": "sans", "bold": true,  "lineHeight": 1.15, "tracking": -0.012 },
      "big":       { "size": 40,  "font": "sans", "bold": false, "lineHeight": 1.12, "tracking": -0.015 },
      "bigBold":   { "size": 40,  "font": "sans", "bold": true,  "lineHeight": 1.12, "tracking": -0.015 },
      "key":       { "size": 28,  "font": "sans", "bold": true,  "lineHeight": 1.3,  "tracking": 0 },
      "lead":      { "size": 28,  "font": "sans", "bold": false, "lineHeight": 1.3,  "tracking": 0 },
      "body":      { "size": 24,  "font": "sans", "bold": false, "lineHeight": 1.38, "tracking": 0 },
      "small":     { "size": 22,  "font": "sans", "bold": false, "lineHeight": 1.4,  "tracking": 0 },
      "caption":   { "size": 18,  "font": "sans", "bold": false, "lineHeight": 1.4,  "tracking": 0 },
      "label":     { "size": 13,  "font": "mono", "bold": false, "lineHeight": 1.23, "tracking": 0.12, "upper": true },
      "monoValue": { "size": 15,  "font": "mono", "bold": false, "lineHeight": 1.2,  "tracking": 0.04 },
      "numeral":   { "size": 96,  "font": "sans", "bold": true,  "lineHeight": 1.0,  "tracking": -0.03 }
    }
  },
  "palette": {
    "paper": "#F6F6F3",
    "ink": "#15182A",
    "primary": "#444BE8",
    "accent": "#A9AEFF",
    "derived": {
      "muted": { "from": "paper", "to": "ink", "weight": 0.62 },
      "rule":  { "from": "paper", "to": "ink", "weight": 0.13 },
      "tint":  { "from": "paper", "to": "primary", "weight": 0.09 },
      "cardRule": { "from": "tint", "to": "ink", "weight": 0.18 }
    },
    "onInk":     { "text": "paper", "secondary": 0.78, "chrome": 0.5, "rulerPast": 0.22, "rulerFuture": 0.1, "accent": "accent" },
    "onPrimary": { "text": "paper", "secondary": 0.8,  "chrome": 0.7, "rulerPast": 0.55, "rulerFuture": 0.28 }
  },
  "surfaces": { "cover": "paper", "statement": "ink", "closing": "primary", "card": "tint", "default": "paper" },
  "chrome": {
    "ruler": { "segment": 28, "height": 3, "gap": 8, "maxSlides": 16 },
    "wordmarkGap": 32
  },
  "spacing": {
    "columnRule": 1, "headerRule": 2,
    "colPadTop": 20, "colGap": 20,
    "cardPad": { "top": 36, "side": 48, "bottom": 32 },
    "rowPad": 22, "factPad": 26, "chartRow": 56, "barHeight": 24
  },
  "policy": {
    "maxTitleLines": { "display": 3, "h1": 2 },
    "maxTitleFill": 0.9,
    "minContentHeight": 150,
    "occupancy": [0.12, 0.42],
    "maxAdjacentSameLayout": 2,
    "statementsPerDeck": 1,
    "maxBodyWords": 40,
    "primaryTextClassesPerSlide": 1,
    "certification": "candidate"
  },
  "imagery": {
    "generation": "forbidden",
    "defaultCount": 0,
    "allowed": "Registered screenshots, photographs or evidence supplied by the customer",
    "decoration": "none",
    "icons": "none",
    "fallback": "Use typography, a comparison, a table or a data row; never invent an image"
  }
}
